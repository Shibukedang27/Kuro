                                        Print FlowFresh.
                                    Done.
                                    If FlowFresh is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq2_Op is equal to "BC_IF_BEGIN";
