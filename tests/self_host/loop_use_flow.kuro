# TEST-ONLY bounded raw-bytecode loop-use analyzer.
# Input is the complete RawTokens list (one exact raw bytecode token per item).
# Supported grammar: optional literal STORE prefixes for up to sixteen exact identifiers;
# one literal-count Repeat (0..9); body = literal STORE slot | LOADVAR slot PRINT
# | literal IF_BEGIN body [ELSE body] IF_END. No other bytecode is accepted.
# This program owns structural parsing, reachability and abstract kind transfer;
# the Python harness only serializes tokens and compares an independent oracle.
# Kinds are bit masks: ?=1, I=2, D=4. 0 means unreachable.
RawTokens is Text;
FlowBad = 0;
FlowPos = 0;
FlowLength = 0;
FlowMasks = 1;
FlowNames = "";
FlowSnapshots = 1;
FlowCapacity = 16;
FlowSnapshotDepthCapacity = 17;
FlowSnapshotKindCapacity = 4;
FlowSnapshotLength = 1088;
# Numeric mask scratch avoids Text-like names in hosted native inference.
FlowUseMask = 0;
FlowPrefixMask = 0;
FlowPending = 0;
FlowCount = 0;
FlowTrip = 0;
FlowEmit = 0;
FlowDecision = 1;
FlowDepth = 0;
# Names are discovered only by the dry validation traversal. The fixed-capacity
# indexed mapping is frozen before execution; every mask and snapshot row has 16 cells.
FlowNameCount = 0;
Length RawTokens;
FlowLength = @_;


# Slot identifiers are exact ASCII identifiers, bounded to 32 characters. The
# reserved BC_ namespace is excluded; no normalization, aliasing, or truncation.
Action FlowResolveName FlowNameValue;
    FlowResolve_Result = -1;
    Length FlowNameValue;
    FlowNameLength = @_;
    FlowNameValid = 1;
    If FlowNameLength is less than 1 or FlowNameLength is greater than 32;
        FlowNameValid = 0;
    Done.
    FlowNameScanPos = 0;
    While FlowNameScanPos is less than FlowNameLength and FlowNameValid is equal to 1;
        Get FlowNameValue FlowNameScanPos;
        FlowNameChar = @_;
        FlowNameCharOK = 0;
        If FlowNameChar is equal to "A" or FlowNameChar is equal to "B" or FlowNameChar is equal to "C" or FlowNameChar is equal to "D" or FlowNameChar is equal to "E" or FlowNameChar is equal to "F" or FlowNameChar is equal to "G" or FlowNameChar is equal to "H" or FlowNameChar is equal to "I" or FlowNameChar is equal to "J" or FlowNameChar is equal to "K" or FlowNameChar is equal to "L" or FlowNameChar is equal to "M" or FlowNameChar is equal to "N" or FlowNameChar is equal to "O" or FlowNameChar is equal to "P" or FlowNameChar is equal to "Q" or FlowNameChar is equal to "R" or FlowNameChar is equal to "S" or FlowNameChar is equal to "T" or FlowNameChar is equal to "U" or FlowNameChar is equal to "V" or FlowNameChar is equal to "W" or FlowNameChar is equal to "X" or FlowNameChar is equal to "Y" or FlowNameChar is equal to "Z" or FlowNameChar is equal to "a" or FlowNameChar is equal to "b" or FlowNameChar is equal to "c" or FlowNameChar is equal to "d" or FlowNameChar is equal to "e" or FlowNameChar is equal to "f" or FlowNameChar is equal to "g" or FlowNameChar is equal to "h" or FlowNameChar is equal to "i" or FlowNameChar is equal to "j" or FlowNameChar is equal to "k" or FlowNameChar is equal to "l" or FlowNameChar is equal to "m" or FlowNameChar is equal to "n" or FlowNameChar is equal to "o" or FlowNameChar is equal to "p" or FlowNameChar is equal to "q" or FlowNameChar is equal to "r" or FlowNameChar is equal to "s" or FlowNameChar is equal to "t" or FlowNameChar is equal to "u" or FlowNameChar is equal to "v" or FlowNameChar is equal to "w" or FlowNameChar is equal to "x" or FlowNameChar is equal to "y" or FlowNameChar is equal to "z" or FlowNameChar is equal to "_";
            FlowNameCharOK = 1;
        Else;
            If FlowNameScanPos is greater than 0;
                If FlowNameChar is equal to "0" or FlowNameChar is equal to "1" or FlowNameChar is equal to "2" or FlowNameChar is equal to "3" or FlowNameChar is equal to "4" or FlowNameChar is equal to "5" or FlowNameChar is equal to "6" or FlowNameChar is equal to "7" or FlowNameChar is equal to "8" or FlowNameChar is equal to "9";
                    FlowNameCharOK = 1;
                Done.
            Done.
        Done.
        If FlowNameCharOK is equal to 0;
            FlowNameValid = 0;
        Done.
        Add 1 to FlowNameScanPos;
    Done.
    If FlowNameLength is greater than 2;
        Get FlowNameValue 0;
        FlowNameFirstChar = @_;
        Get FlowNameValue 1;
        FlowNameSecondChar = @_;
        Get FlowNameValue 2;
        FlowNameThirdChar = @_;
        If FlowNameFirstChar is equal to "B" and FlowNameSecondChar is equal to "C" and FlowNameThirdChar is equal to "_";
            FlowNameValid = 0;
        Done.
    Done.
    If FlowNameValid is equal to 0;
        FlowBad = 1;
    Else;
        FlowNameIndex = 0;
        While FlowNameIndex is less than FlowNameCount and FlowResolve_Result is less than 0;
            If FlowNameIndex is less than 0 or FlowNameIndex is greater than or equal to FlowCapacity;
                FlowBad = 1;
            Else;
                Get FlowNames FlowNameIndex;
                FlowNameCandidate = @_;
            Done.
            If FlowNameCandidate is equal to FlowNameValue;
                FlowResolve_Result = FlowNameIndex;
            Done.
            Add 1 to FlowNameIndex;
        Done.
        If FlowResolve_Result is less than 0;
            If FlowNameCount is greater than or equal to FlowCapacity or FlowEmit is not equal to 0;
                FlowBad = 1;
            Else;
                If FlowNameCount is less than 0 or FlowNameCount is greater than or equal to FlowCapacity;
                    FlowBad = 1;
                Else;
                    Set FlowNames FlowNameCount to FlowNameValue;
                    FlowResolve_Result = FlowNameCount;
                    Add 1 to FlowNameCount;
                Done.
            Done.
        Done.
    Done.
    Return FlowResolve_Result;
Done.

# These helpers are the only bridge from a dynamic exact name to the bounded mask array.
# All dynamically indexed state is bounded and kept at exactly 16 cells.
Action FlowGetMask FlowSlotIndex;
    FlowGetMask_Result = 0;
    If FlowSlotIndex is less than 0 or FlowSlotIndex is greater than or equal to FlowCapacity;
        FlowBad = 1;
    Else;
        Get FlowMasks FlowSlotIndex;
        FlowGetMask_Result = @_;
    Done.
    Return FlowGetMask_Result;
Done.

Action FlowSetMask FlowSlotIndex, FlowSlotMask;
    If FlowSlotIndex is less than 0 or FlowSlotIndex is greater than or equal to FlowCapacity;
        FlowBad = 1;
    Else;
        Set FlowMasks FlowSlotIndex to FlowSlotMask;
    Done.
Done.

Action FlowResetMasks;
    FlowResetIndex = 0;
    While FlowResetIndex is less than FlowCapacity and FlowBad is equal to 0;
        Call FlowSetMask FlowResetIndex, 1;
        Add 1 to FlowResetIndex;
    Done.
Done.

# Snapshot storage is flattened as 17 depths x 4 disjoint rows x 16 slots.
# Branch rows are entry/then/else (0/1/2); depth zero row zero stores loop entry.
# Every operation copies the entire capacity, including currently unused slots.
Action FlowSnapshotSave FlowSnapshotDepth, FlowSnapshotKind;
    If FlowSnapshotDepth is less than 0 or FlowSnapshotDepth is greater than or equal to FlowSnapshotDepthCapacity or FlowSnapshotKind is less than 0 or FlowSnapshotKind is greater than or equal to FlowSnapshotKindCapacity;
        FlowBad = 1;
    Else;
        FlowSnapshotRow = FlowSnapshotDepth * FlowSnapshotKindCapacity + FlowSnapshotKind;
        FlowSnapshotBase = FlowSnapshotRow * FlowCapacity;
        FlowSnapshotSlot = 0;
        While FlowSnapshotSlot is less than FlowCapacity and FlowBad is equal to 0;
            FlowSnapshotIndex = FlowSnapshotBase + FlowSnapshotSlot;
            If FlowSnapshotSlot is less than 0 or FlowSnapshotSlot is greater than or equal to FlowCapacity or FlowSnapshotIndex is less than 0 or FlowSnapshotIndex is greater than or equal to FlowSnapshotLength;
                FlowBad = 1;
            Else;
                Get FlowMasks FlowSnapshotSlot;
                FlowSnapshotValue = @_;
                Set FlowSnapshots FlowSnapshotIndex to FlowSnapshotValue;
            Done.
            Add 1 to FlowSnapshotSlot;
        Done.
    Done.
Done.

Action FlowSnapshotRestore FlowSnapshotDepth, FlowSnapshotKind;
    If FlowSnapshotDepth is less than 0 or FlowSnapshotDepth is greater than or equal to FlowSnapshotDepthCapacity or FlowSnapshotKind is less than 0 or FlowSnapshotKind is greater than or equal to FlowSnapshotKindCapacity;
        FlowBad = 1;
    Else;
        FlowSnapshotRow = FlowSnapshotDepth * FlowSnapshotKindCapacity + FlowSnapshotKind;
        FlowSnapshotBase = FlowSnapshotRow * FlowCapacity;
        FlowSnapshotSlot = 0;
        While FlowSnapshotSlot is less than FlowCapacity and FlowBad is equal to 0;
            FlowSnapshotIndex = FlowSnapshotBase + FlowSnapshotSlot;
            If FlowSnapshotSlot is less than 0 or FlowSnapshotSlot is greater than or equal to FlowCapacity or FlowSnapshotIndex is less than 0 or FlowSnapshotIndex is greater than or equal to FlowSnapshotLength;
                FlowBad = 1;
            Else;
                Get FlowSnapshots FlowSnapshotIndex;
                FlowSnapshotValue = @_;
                Call FlowSetMask FlowSnapshotSlot, FlowSnapshotValue;
            Done.
            Add 1 to FlowSnapshotSlot;
        Done.
    Done.
Done.

Action FlowSnapshotCopy FlowSnapshotDepth, FlowSnapshotFrom, FlowSnapshotTo;
    If FlowSnapshotDepth is less than 0 or FlowSnapshotDepth is greater than or equal to FlowSnapshotDepthCapacity or FlowSnapshotFrom is less than 0 or FlowSnapshotFrom is greater than or equal to FlowSnapshotKindCapacity or FlowSnapshotTo is less than 0 or FlowSnapshotTo is greater than or equal to FlowSnapshotKindCapacity;
        FlowBad = 1;
    Else;
        FlowSnapshotFromRow = FlowSnapshotDepth * FlowSnapshotKindCapacity + FlowSnapshotFrom;
        FlowSnapshotToRow = FlowSnapshotDepth * FlowSnapshotKindCapacity + FlowSnapshotTo;
        FlowSnapshotFromBase = FlowSnapshotFromRow * FlowCapacity;
        FlowSnapshotToBase = FlowSnapshotToRow * FlowCapacity;
        FlowSnapshotSlot = 0;
        While FlowSnapshotSlot is less than FlowCapacity and FlowBad is equal to 0;
            FlowSnapshotFromIndex = FlowSnapshotFromBase + FlowSnapshotSlot;
            FlowSnapshotToIndex = FlowSnapshotToBase + FlowSnapshotSlot;
            If FlowSnapshotSlot is less than 0 or FlowSnapshotSlot is greater than or equal to FlowCapacity or FlowSnapshotFromIndex is less than 0 or FlowSnapshotFromIndex is greater than or equal to FlowSnapshotLength or FlowSnapshotToIndex is less than 0 or FlowSnapshotToIndex is greater than or equal to FlowSnapshotLength;
                FlowBad = 1;
            Else;
                Get FlowSnapshots FlowSnapshotFromIndex;
                FlowSnapshotValue = @_;
                Set FlowSnapshots FlowSnapshotToIndex to FlowSnapshotValue;
            Done.
            Add 1 to FlowSnapshotSlot;
        Done.
    Done.
Done.

Action FlowSnapshotJoin FlowSnapshotDepth, FlowSnapshotThen, FlowSnapshotElse;
    If FlowSnapshotDepth is less than 0 or FlowSnapshotDepth is greater than or equal to FlowSnapshotDepthCapacity or FlowSnapshotThen is less than 0 or FlowSnapshotThen is greater than or equal to FlowSnapshotKindCapacity or FlowSnapshotElse is less than 0 or FlowSnapshotElse is greater than or equal to FlowSnapshotKindCapacity;
        FlowBad = 1;
    Else;
        FlowSnapshotThenRow = FlowSnapshotDepth * FlowSnapshotKindCapacity + FlowSnapshotThen;
        FlowSnapshotElseRow = FlowSnapshotDepth * FlowSnapshotKindCapacity + FlowSnapshotElse;
        FlowSnapshotThenBase = FlowSnapshotThenRow * FlowCapacity;
        FlowSnapshotElseBase = FlowSnapshotElseRow * FlowCapacity;
        FlowSnapshotSlot = 0;
        While FlowSnapshotSlot is less than FlowCapacity and FlowBad is equal to 0;
            FlowSnapshotThenIndex = FlowSnapshotThenBase + FlowSnapshotSlot;
            FlowSnapshotElseIndex = FlowSnapshotElseBase + FlowSnapshotSlot;
            If FlowSnapshotSlot is less than 0 or FlowSnapshotSlot is greater than or equal to FlowCapacity or FlowSnapshotThenIndex is less than 0 or FlowSnapshotThenIndex is greater than or equal to FlowSnapshotLength or FlowSnapshotElseIndex is less than 0 or FlowSnapshotElseIndex is greater than or equal to FlowSnapshotLength;
                FlowBad = 1;
            Else;
                Get FlowSnapshots FlowSnapshotThenIndex;
                FlowSnapshotThenValue = @_;
                Get FlowSnapshots FlowSnapshotElseIndex;
                FlowSnapshotElseValue = @_;
                Call FlowJoin FlowSnapshotThenValue, FlowSnapshotElseValue;
                FlowSnapshotValue = @_;
                Call FlowSetMask FlowSnapshotSlot, FlowSnapshotValue;
            Done.
            Add 1 to FlowSnapshotSlot;
        Done.
    Done.
Done.

Action FlowLiteral TextValue;
    FlowLiteral_Result = 0;
    If TextValue is equal to "0" or TextValue is equal to "1" or TextValue is equal to "2" or TextValue is equal to "3" or TextValue is equal to "4" or TextValue is equal to "5" or TextValue is equal to "6" or TextValue is equal to "7" or TextValue is equal to "8" or TextValue is equal to "9";
        FlowLiteral_Result = 2;
    Else;
        If TextValue is equal to "0.0" or TextValue is equal to "0.5" or TextValue is equal to "1.0" or TextValue is equal to "1.5" or TextValue is equal to "2.0" or TextValue is equal to "2.5" or TextValue is equal to "3.0" or TextValue is equal to "3.5" or TextValue is equal to "4.0" or TextValue is equal to "4.5" or TextValue is equal to "5.0" or TextValue is equal to "5.5" or TextValue is equal to "6.0" or TextValue is equal to "6.5" or TextValue is equal to "7.0" or TextValue is equal to "7.5" or TextValue is equal to "8.0" or TextValue is equal to "8.5" or TextValue is equal to "9.0" or TextValue is equal to "9.5";
            FlowLiteral_Result = 4;
        Else;
            FlowBad = 1;
        Done.
    Done.
    Return FlowLiteral_Result;
Done.

Action FlowJoin Left, Right;
    FlowJoin_Result = 0;
    If Left is equal to 1 or Left is equal to 3 or Left is equal to 5 or Left is equal to 7 or Right is equal to 1 or Right is equal to 3 or Right is equal to 5 or Right is equal to 7;
        Add 1 to FlowJoin_Result;
    Done.
    If Left is equal to 2 or Left is equal to 3 or Left is equal to 6 or Left is equal to 7 or Right is equal to 2 or Right is equal to 3 or Right is equal to 6 or Right is equal to 7;
        Add 2 to FlowJoin_Result;
    Done.
    If Left is equal to 4 or Left is equal to 5 or Left is equal to 6 or Left is equal to 7 or Right is equal to 4 or Right is equal to 5 or Right is equal to 6 or Right is equal to 7;
        Add 4 to FlowJoin_Result;
    Done.
    Return FlowJoin_Result;
Done.

# Branch recovery must never index beyond a truncated input.
Action FlowPeek;
    If FlowPos is less than 0 or FlowPos is greater than or equal to FlowLength;
        FlowBad = 1;
        Return "";
    Done.
    Get RawTokens FlowPos;
    Return @_;
Done.

# Stop mode 1 = ELSE or IF_END; 2 = IF_END; 3 = REPEAT_END.
# Recursive sequence evaluation considers both IF arms and joins their outputs.
Action FlowSequence0 FlowSeq0_Mode;
    FlowSeq0_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq0_Running is equal to 1;
        Call FlowPeek;
        FlowSeq0_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq0_Op is not equal to "BC_STORE_LIST" and FlowSeq0_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq0_IsStop = 0;
        If FlowSeq0_Mode is equal to 1 and FlowSeq0_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq0_IsStop = 1;
        Done.
        If FlowSeq0_Op is equal to "BC_IF_END" and FlowSeq0_Mode is not equal to 3;
            FlowSeq0_IsStop = 1;
        Done.
        If FlowSeq0_Mode is equal to 3 and FlowSeq0_Op is equal to "BC_REPEAT_END";
            FlowSeq0_IsStop = 1;
        Done.
        If FlowSeq0_IsStop is equal to 1;
            FlowSeq0_Running = 0;
        Else;
            If FlowSeq0_Op is equal to "BC_CONST";
                FlowSeq0_ArgPos = FlowPos + 1;
                If FlowSeq0_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq0_ArgPos;
                    FlowSeq0_Value = @_;
                    Call FlowLiteral FlowSeq0_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq0_Op is equal to "BC_STORE_LIST";
                    FlowSeq0_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq0_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq0_ArgPos;
                        FlowSeq0_Name = @_;
                        Call FlowResolveName FlowSeq0_Name;
                        FlowSlotIndex = @_;
                        If FlowBad is equal to 0;
                            Call FlowSetMask FlowSlotIndex, FlowPending;
                        Done.
                        If FlowBad is equal to 0;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq0_Op is equal to "BC_LOADVAR";
                        FlowSeq0_ArgPos = FlowPos + 1;
                        FlowSeq0_PrintPos = FlowPos + 2;
                        If FlowSeq0_PrintPos is greater than or equal to FlowLength or FlowSeq0_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq0_ArgPos;
                            FlowSeq0_Name = @_;
                            Call FlowResolveName FlowSeq0_Name;
                            FlowSlotIndex = @_;
                            FlowSeq0_NameOK = 0;
                            If FlowBad is equal to 0;
                                FlowSeq0_NameOK = 1;
                            Done.
                            Get RawTokens FlowSeq0_PrintPos;
                            If FlowSeq0_NameOK is equal to 0 or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                FlowUseName = FlowSeq0_Name;
                                Call FlowGetMask FlowSlotIndex;
                                FlowUseMask = @_;
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "E".
                                        Print FlowUseMask.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "B".
                                        Print FlowUseMask.
                                    Done.
                                    If FlowUseMask is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq0_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                Call FlowSnapshotSave FlowDepth, 0;
                                FlowPos = FlowPos + 1;
                                Call FlowSequence1 1;
                                Call FlowSnapshotSave FlowDepth, 1;
                                Call FlowPeek;
                                FlowSeq0_Stop = @_;
                                If FlowSeq0_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    Call FlowSnapshotRestore FlowDepth, 0;
                                    Call FlowSequence1 2;
                                    Call FlowSnapshotSave FlowDepth, 2;
                                Else;
                                    Call FlowSnapshotCopy FlowDepth, 0, 2;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowSnapshotJoin FlowDepth, 1, 2;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq0_Op is equal to "BC_ELSE_BEGIN" or FlowSeq0_Op is equal to "BC_IF_END" or FlowSeq0_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq0_Op is equal to "BC_REPEAT_END" or FlowSeq0_Op is equal to "BC_WHILE_BEGIN" or FlowSeq0_Op is equal to "BC_WHILE_TEST" or FlowSeq0_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.


Action FlowSequence1 FlowSeq1_Mode;
    FlowSeq1_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq1_Running is equal to 1;
        Call FlowPeek;
        FlowSeq1_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq1_Op is not equal to "BC_STORE_LIST" and FlowSeq1_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq1_IsStop = 0;
        If FlowSeq1_Mode is equal to 1 and FlowSeq1_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq1_IsStop = 1;
        Done.
        If FlowSeq1_Op is equal to "BC_IF_END" and FlowSeq1_Mode is not equal to 3;
            FlowSeq1_IsStop = 1;
        Done.
        If FlowSeq1_Mode is equal to 3 and FlowSeq1_Op is equal to "BC_REPEAT_END";
            FlowSeq1_IsStop = 1;
        Done.
        If FlowSeq1_IsStop is equal to 1;
            FlowSeq1_Running = 0;
        Else;
            If FlowSeq1_Op is equal to "BC_CONST";
                FlowSeq1_ArgPos = FlowPos + 1;
                If FlowSeq1_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq1_ArgPos;
                    FlowSeq1_Value = @_;
                    Call FlowLiteral FlowSeq1_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq1_Op is equal to "BC_STORE_LIST";
                    FlowSeq1_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq1_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq1_ArgPos;
                        FlowSeq1_Name = @_;
                        Call FlowResolveName FlowSeq1_Name;
                        FlowSlotIndex = @_;
                        If FlowBad is equal to 0;
                            Call FlowSetMask FlowSlotIndex, FlowPending;
                        Done.
                        If FlowBad is equal to 0;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq1_Op is equal to "BC_LOADVAR";
                        FlowSeq1_ArgPos = FlowPos + 1;
                        FlowSeq1_PrintPos = FlowPos + 2;
                        If FlowSeq1_PrintPos is greater than or equal to FlowLength or FlowSeq1_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq1_ArgPos;
                            FlowSeq1_Name = @_;
                            Call FlowResolveName FlowSeq1_Name;
                            FlowSlotIndex = @_;
                            FlowSeq1_NameOK = 0;
                            If FlowBad is equal to 0;
                                FlowSeq1_NameOK = 1;
                            Done.
                            Get RawTokens FlowSeq1_PrintPos;
                            If FlowSeq1_NameOK is equal to 0 or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                FlowUseName = FlowSeq1_Name;
                                Call FlowGetMask FlowSlotIndex;
                                FlowUseMask = @_;
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "E".
                                        Print FlowUseMask.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "B".
                                        Print FlowUseMask.
                                    Done.
                                    If FlowUseMask is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq1_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                Call FlowSnapshotSave FlowDepth, 0;
                                FlowPos = FlowPos + 1;
                                Call FlowSequence2 1;
                                Call FlowSnapshotSave FlowDepth, 1;
                                Call FlowPeek;
                                FlowSeq1_Stop = @_;
                                If FlowSeq1_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    Call FlowSnapshotRestore FlowDepth, 0;
                                    Call FlowSequence2 2;
                                    Call FlowSnapshotSave FlowDepth, 2;
                                Else;
                                    Call FlowSnapshotCopy FlowDepth, 0, 2;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowSnapshotJoin FlowDepth, 1, 2;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq1_Op is equal to "BC_ELSE_BEGIN" or FlowSeq1_Op is equal to "BC_IF_END" or FlowSeq1_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq1_Op is equal to "BC_REPEAT_END" or FlowSeq1_Op is equal to "BC_WHILE_BEGIN" or FlowSeq1_Op is equal to "BC_WHILE_TEST" or FlowSeq1_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.


Action FlowSequence2 FlowSeq2_Mode;
    FlowSeq2_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq2_Running is equal to 1;
        Call FlowPeek;
        FlowSeq2_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq2_Op is not equal to "BC_STORE_LIST" and FlowSeq2_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq2_IsStop = 0;
        If FlowSeq2_Mode is equal to 1 and FlowSeq2_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq2_IsStop = 1;
        Done.
        If FlowSeq2_Op is equal to "BC_IF_END" and FlowSeq2_Mode is not equal to 3;
            FlowSeq2_IsStop = 1;
        Done.
        If FlowSeq2_Mode is equal to 3 and FlowSeq2_Op is equal to "BC_REPEAT_END";
            FlowSeq2_IsStop = 1;
        Done.
        If FlowSeq2_IsStop is equal to 1;
            FlowSeq2_Running = 0;
        Else;
            If FlowSeq2_Op is equal to "BC_CONST";
                FlowSeq2_ArgPos = FlowPos + 1;
                If FlowSeq2_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq2_ArgPos;
                    FlowSeq2_Value = @_;
                    Call FlowLiteral FlowSeq2_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq2_Op is equal to "BC_STORE_LIST";
                    FlowSeq2_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq2_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
