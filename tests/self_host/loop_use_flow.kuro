        If FlowSeq15_Op is equal to "BC_IF_END" and FlowSeq15_Mode is not equal to 3;
            FlowSeq15_IsStop = 1;
        Done.
        If FlowSeq15_Mode is equal to 3 and FlowSeq15_Op is equal to "BC_REPEAT_END";
            FlowSeq15_IsStop = 1;
        Done.
        If FlowSeq15_IsStop is equal to 1;
            FlowSeq15_Running = 0;
        Else;
            If FlowSeq15_Op is equal to "BC_CONST";
                FlowSeq15_ArgPos = FlowPos + 1;
                If FlowSeq15_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq15_ArgPos;
                    FlowSeq15_Value = @_;
                    Call FlowLiteral FlowSeq15_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq15_Op is equal to "BC_STORE_LIST";
                    FlowSeq15_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq15_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq15_ArgPos;
                        If @_ is not equal to "Fresh";
                            FlowBad = 1;
                        Else;
                            FlowFresh = FlowPending;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq15_Op is equal to "BC_LOADVAR";
                        FlowSeq15_ArgPos = FlowPos + 1;
                        FlowSeq15_PrintPos = FlowPos + 2;
                        If FlowSeq15_PrintPos is greater than or equal to FlowLength or FlowSeq15_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq15_ArgPos;
                            FlowSeq15_Name = @_;
                            Get RawTokens FlowSeq15_PrintPos;
                            If FlowSeq15_Name is not equal to "Fresh" or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print "E".
                                        Print FlowFresh.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print "B".
                                        Print FlowFresh.
                                    Done.
                                    If FlowFresh is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq15_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                FlowSeq15_Entry = FlowFresh;
                                FlowPos = FlowPos + 1;
                                Call FlowSequence16 1;
                                FlowSeq15_Then = FlowFresh;
                                Call FlowPeek;
                                FlowSeq15_Stop = @_;
                                If FlowSeq15_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    FlowFresh = FlowSeq15_Entry;
                                    Call FlowSequence16 2;
                                    FlowSeq15_Else = FlowFresh;
                                Else;
                                    FlowSeq15_Else = FlowSeq15_Entry;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowJoin FlowSeq15_Then, FlowSeq15_Else;
                                    FlowFresh = @_;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq15_Op is equal to "BC_ELSE_BEGIN" or FlowSeq15_Op is equal to "BC_IF_END" or FlowSeq15_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq15_Op is equal to "BC_REPEAT_END" or FlowSeq15_Op is equal to "BC_WHILE_BEGIN" or FlowSeq15_Op is equal to "BC_WHILE_TEST" or FlowSeq15_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.


Action FlowSequence16 FlowSeq16_Mode;
    FlowSeq16_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq16_Running is equal to 1;
        Call FlowPeek;
        FlowSeq16_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq16_Op is not equal to "BC_STORE_LIST" and FlowSeq16_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq16_IsStop = 0;
        If FlowSeq16_Mode is equal to 1 and FlowSeq16_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq16_IsStop = 1;
        Done.
        If FlowSeq16_Op is equal to "BC_IF_END" and FlowSeq16_Mode is not equal to 3;
            FlowSeq16_IsStop = 1;
        Done.
        If FlowSeq16_Mode is equal to 3 and FlowSeq16_Op is equal to "BC_REPEAT_END";
            FlowSeq16_IsStop = 1;
        Done.
        If FlowSeq16_IsStop is equal to 1;
            FlowSeq16_Running = 0;
        Else;
            If FlowSeq16_Op is equal to "BC_CONST";
                FlowSeq16_ArgPos = FlowPos + 1;
                If FlowSeq16_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq16_ArgPos;
                    FlowSeq16_Value = @_;
                    Call FlowLiteral FlowSeq16_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq16_Op is equal to "BC_STORE_LIST";
                    FlowSeq16_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq16_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq16_ArgPos;
                        If @_ is not equal to "Fresh";
                            FlowBad = 1;
                        Else;
                            FlowFresh = FlowPending;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq16_Op is equal to "BC_LOADVAR";
                        FlowSeq16_ArgPos = FlowPos + 1;
                        FlowSeq16_PrintPos = FlowPos + 2;
                        If FlowSeq16_PrintPos is greater than or equal to FlowLength or FlowSeq16_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq16_ArgPos;
                            FlowSeq16_Name = @_;
                            Get RawTokens FlowSeq16_PrintPos;
                            If FlowSeq16_Name is not equal to "Fresh" or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print "E".
                                        Print FlowFresh.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print "B".
                                        Print FlowFresh.
                                    Done.
                                    If FlowFresh is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq16_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                FlowSeq16_Entry = FlowFresh;
                                FlowPos = FlowPos + 1;
                                FlowBad = 1;
                                FlowSeq16_Then = FlowFresh;
                                Call FlowPeek;
                                FlowSeq16_Stop = @_;
                                If FlowSeq16_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    FlowFresh = FlowSeq16_Entry;
                                    FlowBad = 1;
                                    FlowSeq16_Else = FlowFresh;
                                Else;
                                    FlowSeq16_Else = FlowSeq16_Entry;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowJoin FlowSeq16_Then, FlowSeq16_Else;
                                    FlowFresh = @_;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq16_Op is equal to "BC_ELSE_BEGIN" or FlowSeq16_Op is equal to "BC_IF_END" or FlowSeq16_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq16_Op is equal to "BC_REPEAT_END" or FlowSeq16_Op is equal to "BC_WHILE_BEGIN" or FlowSeq16_Op is equal to "BC_WHILE_TEST" or FlowSeq16_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.

# Validate and then execute; no Python-provided CFG, identities, or facts.
Action FlowAnalyze;
    FlowBad = 0;
    FlowPos = 0;
    FlowFresh = 1;
    FlowPending = 0;
    FlowEmit = 0;
    If FlowLength is greater than 128;
        FlowBad = 1;
    Done.
    # A leading literal is an initializer only when followed by STORE_LIST.
    If FlowBad is equal to 0 and FlowLength is greater than 3;
        Get RawTokens 0;
        If @_ is equal to "BC_CONST";
            Get RawTokens 2;
            If @_ is equal to "BC_STORE_LIST";
                Get RawTokens 1;
                FlowInitialValue = @_;
                Call FlowLiteral FlowInitialValue;
                FlowInitialKind = @_;
                If FlowInitialKind is equal to 0;
                    FlowBad = 1;
                Else;
                    Get RawTokens 3;
                    If @_ is not equal to "Fresh";
                        FlowBad = 1;
                    Else;
                        FlowPos = 4;
                    Done.
                Done.
            Done.
        Done.
    Done.
    # A single literal-count outer Repeat is required.
    If FlowBad is equal to 0 and FlowPos is less than FlowLength;
        Call FlowPeek;
        If @_ is not equal to "BC_CONST";
            FlowBad = 1;
        Else;
            FlowCountPos = FlowPos + 1;
            If FlowCountPos is greater than or equal to FlowLength;
                FlowBad = 1;
            Else;
                Get RawTokens FlowCountPos;
                FlowCountText = @_;
                If FlowCountText is equal to "0";
                    FlowCount = 0;
                Else;
                    If FlowCountText is equal to "1";
                        FlowCount = 1;
                    Else;
                        If FlowCountText is equal to "2" or FlowCountText is equal to "3" or FlowCountText is equal to "4" or FlowCountText is equal to "5" or FlowCountText is equal to "6" or FlowCountText is equal to "7" or FlowCountText is equal to "8" or FlowCountText is equal to "9";
                            # Literal overwrites + conservative branches give either
                            # F(S)=C or F(S)=S union C, so F(F(S))=F(S).
                            # Every later trip therefore has the same incoming state
                            # as trip 2. This is finite-trip evidence, not a general
                            # CFG/header fixed point or a widening rule.
                            FlowCount = 2;
                        Else;
                            FlowBad = 1;
                        Done.
                    Done.
                Done.
                FlowBeginPos = FlowPos + 2;
                If FlowBeginPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowBeginPos;
                    If @_ is not equal to "BC_REPEAT_BEGIN";
                        FlowBad = 1;
                    Else;
                        FlowPos = FlowBeginPos + 1;
                        # Dry structural pass: body syntax and full input consumption.
                        FlowFresh = 1;
                        FlowPending = 0;
                        FlowDepth = 0;
                        Call FlowSequence0 3;
                        If FlowPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Call FlowPeek;
                            If @_ is not equal to "BC_REPEAT_END";
                                FlowBad = 1;
                            Else;
                                FlowPos = FlowPos + 1;
                                If FlowPos is not equal to FlowLength;
                                    FlowBad = 1;
                                Done.
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Else;
        FlowBad = 1;
    Done.
    If FlowBad is equal to 0;
        # Re-evaluate with incoming slot state; every use gets an entry record
        # on trip zero and backedge records on subsequent literal trips.
        If FlowLength is greater than 3;
            Get RawTokens 0;
            If @_ is equal to "BC_CONST";
                Get RawTokens 2;
                If @_ is equal to "BC_STORE_LIST";
                    FlowFresh = FlowInitialKind;
                    FlowPos = 4;
                Else;
                    FlowFresh = 1;
                    FlowPos = 0;
                Done.
            Else;
                FlowFresh = 1;
                FlowPos = 0;
            Done.
        Else;
            FlowFresh = 1;
            FlowPos = 0;
        Done.
        FlowPos = FlowPos + 2;
        FlowPos = FlowPos + 1;
        # position now points to first body token after count and REPEAT_BEGIN
        FlowEmit = 1;
        FlowDecision = 1;
        FlowTrip = 0;
        If FlowCount is equal to 0;
            FlowScanPos = FlowBeginPos + 1;
            While FlowScanPos is less than FlowLength;
                Get RawTokens FlowScanPos;
                If @_ is equal to "BC_LOADVAR";
                    Print "USE".
                    Print FlowScanPos.
                    Print "E".
                    Print "0".
                    Print "USE".
                    Print FlowScanPos.
                    Print "B".
                    Print "0".
                Done.
                Add 1 to FlowScanPos;
            Done.
        Else;
            If FlowCount is equal to 1;
                FlowScanPos = FlowBeginPos + 1;
                While FlowScanPos is less than FlowLength;
                    Get RawTokens FlowScanPos;
                    If @_ is equal to "BC_LOADVAR";
                        Print "USE".
                        Print FlowScanPos.
                        Print "B".
                        Print "0".
                    Done.
                    Add 1 to FlowScanPos;
                Done.
            Done.
            FlowTrip = 0;
            Call FlowSequence0 3;
            FlowTrip = 1;
            FlowLoopBound = FlowCount;
            While FlowTrip is less than FlowLoopBound and FlowBad is equal to 0;
                FlowPos = FlowBeginPos + 1;
                Call FlowSequence0 3;
                Add 1 to FlowTrip;
            Done.
        Done.
        If FlowDecision is equal to 1;
            Print "DECISION".
            Print "1".
        Else;
            Print "DECISION".
            Print "0".
        Done.
    Else;
        Print "REJECT".
    Done.
Done.

Call FlowAnalyze;
