                    Else;
                        If FlowSeq16_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                Call FlowSnapshotSave FlowDepth, 0;
                                FlowPos = FlowPos + 1;
                                FlowBad = 1;
                                Call FlowSnapshotSave FlowDepth, 1;
                                Call FlowPeek;
                                FlowSeq16_Stop = @_;
                                If FlowSeq16_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    Call FlowSnapshotRestore FlowDepth, 0;
                                    FlowBad = 1;
                                    Call FlowSnapshotSave FlowDepth, 2;
                                Else;
                                    Call FlowSnapshotCopy FlowDepth, 0, 2;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowSnapshotJoin FlowDepth, 1, 2;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq16_Op is equal to "BC_ELSE_BEGIN" or FlowSeq16_Op is equal to "BC_IF_END" or FlowSeq16_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq16_Op is equal to "BC_REPEAT_END" or FlowSeq16_Op is equal to "BC_WHILE_BEGIN" or FlowSeq16_Op is equal to "BC_WHILE_TEST" or FlowSeq16_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.

# Validate and then execute; no Python-provided CFG, identities, or facts.
Action FlowAnalyze;
    FlowBad = 0;
    FlowPos = 0;
    Call FlowResetMasks;
    FlowPending = 0;
    FlowEmit = 0;
    If FlowLength is greater than 128;
        FlowBad = 1;
    Done.
    # Optional prefix: zero or more literal STORE_LIST slot pairs.
    Call FlowResetMasks;
    FlowPrefix = 1;
    FlowPrefixEnd = 0;
    While FlowBad is equal to 0 and FlowPrefix is equal to 1;
        If FlowPos + 2 is less than FlowLength;
            Get RawTokens FlowPos;
            If @_ is equal to "BC_CONST";
                FlowPrefixStorePos = FlowPos + 2;
                Get RawTokens FlowPrefixStorePos;
                If @_ is equal to "BC_STORE_LIST";
                    FlowPrefixValuePos = FlowPos + 1;
                    FlowPrefixNamePos = FlowPos + 3;
                    If FlowPrefixNamePos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowPrefixValuePos;
                        FlowPrefixValue = @_;
                        Call FlowLiteral FlowPrefixValue;
                        FlowPrefixMask = @_;
                        Get RawTokens FlowPrefixNamePos;
                        FlowPrefixName = @_;
                        If FlowPrefixMask is equal to 0;
                            FlowBad = 1;
                        Else;
                            Call FlowResolveName FlowPrefixName;
                            FlowSlotIndex = @_;
                            If FlowBad is equal to 0;
                                Call FlowSetMask FlowSlotIndex, FlowPrefixMask;
                            Done.
                        Done.
                        If FlowBad is equal to 0;
                            FlowPos = FlowPos + 4;
                            FlowPrefixEnd = FlowPos;
                        Done.
                    Done.
                Else;
                    FlowPrefix = 0;
                Done.
            Else;
                FlowPrefix = 0;
            Done.
        Else;
            FlowPrefix = 0;
        Done.
    Done.
    Call FlowSnapshotSave 0, 0;
    # A single literal-count outer Repeat is required.
    If FlowBad is equal to 0 and FlowPos is less than FlowLength;
        Call FlowPeek;
        If @_ is not equal to "BC_CONST";
            FlowBad = 1;
        Else;
            FlowCountPos = FlowPos + 1;
            If FlowCountPos is greater than or equal to FlowLength;
                FlowBad = 1;
            Else;
                Get RawTokens FlowCountPos;
                FlowCountText = @_;
                If FlowCountText is equal to "0";
                    FlowCount = 0;
                Else;
                    If FlowCountText is equal to "1";
                        FlowCount = 1;
                    Else;
                        If FlowCountText is equal to "2" or FlowCountText is equal to "3" or FlowCountText is equal to "4" or FlowCountText is equal to "5" or FlowCountText is equal to "6" or FlowCountText is equal to "7" or FlowCountText is equal to "8" or FlowCountText is equal to "9";
                            # Literal overwrites + conservative branches give either
                            # F(S)=C or F(S)=S union C, so F(F(S))=F(S).
                            # Every later trip therefore has the same incoming state
                            # as trip 2. This is finite-trip evidence, not a general
                            # CFG/header fixed point or a widening rule.
                            FlowCount = 2;
                        Else;
                            FlowBad = 1;
                        Done.
                    Done.
                Done.
                FlowBeginPos = FlowPos + 2;
                If FlowBeginPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowBeginPos;
                    If @_ is not equal to "BC_REPEAT_BEGIN";
                        FlowBad = 1;
                    Else;
                        FlowPos = FlowBeginPos + 1;
                        # Dry structural pass: body syntax and full input consumption.
                        Call FlowResetMasks;
                        FlowPending = 0;
                        FlowDepth = 0;
                        Call FlowSequence0 3;
                        If FlowPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Call FlowPeek;
                            If @_ is not equal to "BC_REPEAT_END";
                                FlowBad = 1;
                            Else;
                                FlowPos = FlowPos + 1;
                                If FlowPos is not equal to FlowLength;
                                    FlowBad = 1;
                                Done.
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Else;
        FlowBad = 1;
    Done.
    If FlowBad is equal to 0;
        # Re-evaluate with incoming slot state; every use gets an entry record
        # on trip zero and backedge records on subsequent literal trips.
        Call FlowSnapshotRestore 0, 0;
        FlowPos = FlowPrefixEnd;
        FlowPos = FlowPos + 2;
        FlowPos = FlowPos + 1;
        # position now points to first body token after count and REPEAT_BEGIN
        FlowEmit = 1;
        FlowDecision = 1;
        FlowTrip = 0;
        If FlowCount is equal to 0;
            FlowScanPos = FlowBeginPos + 1;
            While FlowScanPos is less than FlowLength;
                Get RawTokens FlowScanPos;
                If @_ is equal to "BC_LOADVAR";
                    FlowScanNamePos = FlowScanPos + 1;
                    Get RawTokens FlowScanNamePos;
                    FlowScanName = @_;
                    Print "USE".
                    Print FlowScanPos.
                    Print FlowScanName.
                    Print "E".
                    Print "0".
                    Print "USE".
                    Print FlowScanPos.
                    Print FlowScanName.
                    Print "B".
                    Print "0".
                Done.
                Add 1 to FlowScanPos;
            Done.
        Else;
            If FlowCount is equal to 1;
                FlowScanPos = FlowBeginPos + 1;
                While FlowScanPos is less than FlowLength;
                    Get RawTokens FlowScanPos;
                    If @_ is equal to "BC_LOADVAR";
                        FlowScanNamePos = FlowScanPos + 1;
                        Get RawTokens FlowScanNamePos;
                        FlowScanName = @_;
                        Print "USE".
                        Print FlowScanPos.
                        Print FlowScanName.
                        Print "B".
                        Print "0".
                    Done.
                    Add 1 to FlowScanPos;
                Done.
            Done.
            FlowTrip = 0;
            Call FlowSequence0 3;
            FlowTrip = 1;
            FlowLoopBound = FlowCount;
            While FlowTrip is less than FlowLoopBound and FlowBad is equal to 0;
                FlowPos = FlowBeginPos + 1;
                Call FlowSequence0 3;
                Add 1 to FlowTrip;
            Done.
        Done.
        If FlowDecision is equal to 1;
            Print "DECISION".
            Print "1".
        Else;
            Print "DECISION".
            Print "0".
        Done.
    Else;
        Print "REJECT".
    Done.
Done.

FlowInitIndex = 1;
While FlowInitIndex is less than FlowCapacity;
    Append 1 to FlowMasks;
    Append "" to FlowNames;
    Add 1 to FlowInitIndex;
Done.
FlowSnapshotInitIndex = 1;
While FlowSnapshotInitIndex is less than FlowSnapshotLength;
    Append 1 to FlowSnapshots;
    Add 1 to FlowSnapshotInitIndex;
Done.
Call FlowAnalyze;
