# Validate and then execute; no Python-provided CFG, identities, or facts.
Action FlowAnalyze;
    FlowBad = 0;
    FlowPos = 0;
    FlowFresh = 1;
    FlowPending = 0;
    FlowEmit = 0;
    If FlowLength is greater than 128;
        FlowBad = 1;
    Done.
    # Optional prefix: zero or more literal STORE_LIST slot pairs.
    FlowFresh = 1;
    FlowOther = 1;
    FlowThird = 1;
    FlowFourth = 1;
    FlowPrefix = 1;
    FlowPrefixEnd = 0;
    While FlowBad is equal to 0 and FlowPrefix is equal to 1;
        If FlowPos + 2 is less than FlowLength;
            Get RawTokens FlowPos;
            If @_ is equal to "BC_CONST";
                FlowPrefixStorePos = FlowPos + 2;
                Get RawTokens FlowPrefixStorePos;
                If @_ is equal to "BC_STORE_LIST";
                    FlowPrefixValuePos = FlowPos + 1;
                    FlowPrefixNamePos = FlowPos + 3;
                    If FlowPrefixNamePos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowPrefixValuePos;
                        FlowPrefixValue = @_;
                        Call FlowLiteral FlowPrefixValue;
                        FlowPrefixMask = @_;
                        Get RawTokens FlowPrefixNamePos;
                        FlowPrefixName = @_;
                        If FlowPrefixMask is equal to 0;
                            FlowBad = 1;
                        Else;
                            If FlowPrefixName is equal to "Fresh";
                                FlowFresh = FlowPrefixMask;
                            Else;
                                If FlowPrefixName is equal to "Other";
                                    FlowOther = FlowPrefixMask;
                                Else;
                                    If FlowPrefixName is equal to "Third";
                                        FlowThird = FlowPrefixMask;
                                    Else;
                                        If FlowPrefixName is equal to "Fourth";
                                            FlowFourth = FlowPrefixMask;
                                        Else;
                                            FlowBad = 1;
                                        Done.
                                    Done.
                                Done.
                            Done.
                        Done.
                        If FlowBad is equal to 0;
                            FlowPos = FlowPos + 4;
                            FlowPrefixEnd = FlowPos;
                        Done.
                    Done.
                Else;
                    FlowPrefix = 0;
                Done.
            Else;
                FlowPrefix = 0;
            Done.
        Else;
            FlowPrefix = 0;
        Done.
    Done.
    FlowStartFresh = FlowFresh;
    FlowStartOther = FlowOther;
    FlowStartThird = FlowThird;
    FlowStartFourth = FlowFourth;
    # A single literal-count outer Repeat is required.
    If FlowBad is equal to 0 and FlowPos is less than FlowLength;
        Call FlowPeek;
        If @_ is not equal to "BC_CONST";
            FlowBad = 1;
        Else;
            FlowCountPos = FlowPos + 1;
            If FlowCountPos is greater than or equal to FlowLength;
                FlowBad = 1;
            Else;
                Get RawTokens FlowCountPos;
                FlowCountText = @_;
                If FlowCountText is equal to "0";
                    FlowCount = 0;
                Else;
                    If FlowCountText is equal to "1";
                        FlowCount = 1;
                    Else;
                        If FlowCountText is equal to "2" or FlowCountText is equal to "3" or FlowCountText is equal to "4" or FlowCountText is equal to "5" or FlowCountText is equal to "6" or FlowCountText is equal to "7" or FlowCountText is equal to "8" or FlowCountText is equal to "9";
                            # Literal overwrites + conservative branches give either
                            # F(S)=C or F(S)=S union C, so F(F(S))=F(S).
                            # Every later trip therefore has the same incoming state
                            # as trip 2. This is finite-trip evidence, not a general
                            # CFG/header fixed point or a widening rule.
                            FlowCount = 2;
                        Else;
                            FlowBad = 1;
                        Done.
                    Done.
                Done.
                FlowBeginPos = FlowPos + 2;
                If FlowBeginPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowBeginPos;
                    If @_ is not equal to "BC_REPEAT_BEGIN";
                        FlowBad = 1;
                    Else;
                        FlowPos = FlowBeginPos + 1;
                        # Dry structural pass: body syntax and full input consumption.
                        FlowFresh = 1;
                        FlowOther = 1;
                        FlowThird = 1;
                        FlowFourth = 1;
                        FlowPending = 0;
                        FlowDepth = 0;
                        Call FlowSequence0 3;
                        If FlowPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Call FlowPeek;
                            If @_ is not equal to "BC_REPEAT_END";
                                FlowBad = 1;
                            Else;
                                FlowPos = FlowPos + 1;
                                If FlowPos is not equal to FlowLength;
                                    FlowBad = 1;
                                Done.
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Else;
        FlowBad = 1;
    Done.
    If FlowBad is equal to 0;
        # Re-evaluate with incoming slot state; every use gets an entry record
        # on trip zero and backedge records on subsequent literal trips.
        FlowFresh = FlowStartFresh;
        FlowOther = FlowStartOther;
        FlowThird = FlowStartThird;
        FlowFourth = FlowStartFourth;
        FlowPos = FlowPrefixEnd;
        FlowPos = FlowPos + 2;
        FlowPos = FlowPos + 1;
        # position now points to first body token after count and REPEAT_BEGIN
        FlowEmit = 1;
        FlowDecision = 1;
        FlowTrip = 0;
        If FlowCount is equal to 0;
            FlowScanPos = FlowBeginPos + 1;
            While FlowScanPos is less than FlowLength;
                Get RawTokens FlowScanPos;
                If @_ is equal to "BC_LOADVAR";
                    FlowScanNamePos = FlowScanPos + 1;
                    Get RawTokens FlowScanNamePos;
                    FlowScanName = @_;
                    Print "USE".
                    Print FlowScanPos.
                    Print FlowScanName.
                    Print "E".
                    Print "0".
                    Print "USE".
                    Print FlowScanPos.
                    Print FlowScanName.
                    Print "B".
                    Print "0".
                Done.
                Add 1 to FlowScanPos;
            Done.
        Else;
            If FlowCount is equal to 1;
                FlowScanPos = FlowBeginPos + 1;
                While FlowScanPos is less than FlowLength;
                    Get RawTokens FlowScanPos;
                    If @_ is equal to "BC_LOADVAR";
                        FlowScanNamePos = FlowScanPos + 1;
                        Get RawTokens FlowScanNamePos;
                        FlowScanName = @_;
                        Print "USE".
                        Print FlowScanPos.
                        Print FlowScanName.
                        Print "B".
                        Print "0".
                    Done.
                    Add 1 to FlowScanPos;
                Done.
            Done.
            FlowTrip = 0;
            Call FlowSequence0 3;
            FlowTrip = 1;
            FlowLoopBound = FlowCount;
            While FlowTrip is less than FlowLoopBound and FlowBad is equal to 0;
                FlowPos = FlowBeginPos + 1;
                Call FlowSequence0 3;
                Add 1 to FlowTrip;
            Done.
        Done.
        If FlowDecision is equal to 1;
            Print "DECISION".
            Print "1".
        Else;
            Print "DECISION".
            Print "0".
        Done.
    Else;
        Print "REJECT".
    Done.
Done.

Call FlowAnalyze;
