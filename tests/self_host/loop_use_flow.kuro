# TEST-ONLY bounded raw-bytecode loop-use analyzer.
# Input is the complete RawTokens list (one exact raw bytecode token per item).
# Supported grammar: optional literal STORE prefixes for Fresh, Other, Third, Fourth;
# one literal-count Repeat (0..9); body = literal STORE slot | LOADVAR slot PRINT
# | literal IF_BEGIN body [ELSE body] IF_END. No other bytecode is accepted.
# This program owns structural parsing, reachability and abstract kind transfer;
# the Python harness only serializes tokens and compares an independent oracle.
# Kinds are bit masks: ?=1, I=2, D=4. 0 means unreachable.
RawTokens is Text;
FlowBad = 0;
FlowPos = 0;
FlowLength = 0;
FlowFresh = 1;
FlowOther = 1;
FlowThird = 1;
FlowFourth = 1;
# Numeric mask scratch avoids Text-like names in hosted native inference.
FlowUseMask = 0;
FlowPrefixMask = 0;
FlowPending = 0;
FlowCount = 0;
FlowTrip = 0;
FlowEmit = 0;
FlowDecision = 1;
FlowDepth = 0;
Length RawTokens;
FlowLength = @_;

Action FlowLiteral TextValue;
    FlowLiteral_Result = 0;
    If TextValue is equal to "0" or TextValue is equal to "1" or TextValue is equal to "2" or TextValue is equal to "3" or TextValue is equal to "4" or TextValue is equal to "5" or TextValue is equal to "6" or TextValue is equal to "7" or TextValue is equal to "8" or TextValue is equal to "9";
        FlowLiteral_Result = 2;
    Else;
        If TextValue is equal to "0.0" or TextValue is equal to "0.5" or TextValue is equal to "1.0" or TextValue is equal to "1.5" or TextValue is equal to "2.0" or TextValue is equal to "2.5" or TextValue is equal to "3.0" or TextValue is equal to "3.5" or TextValue is equal to "4.0" or TextValue is equal to "4.5" or TextValue is equal to "5.0" or TextValue is equal to "5.5" or TextValue is equal to "6.0" or TextValue is equal to "6.5" or TextValue is equal to "7.0" or TextValue is equal to "7.5" or TextValue is equal to "8.0" or TextValue is equal to "8.5" or TextValue is equal to "9.0" or TextValue is equal to "9.5";
            FlowLiteral_Result = 4;
        Else;
            FlowBad = 1;
        Done.
    Done.
    Return FlowLiteral_Result;
Done.

Action FlowJoin Left, Right;
    FlowJoin_Result = 0;
    If Left is equal to 1 or Left is equal to 3 or Left is equal to 5 or Left is equal to 7 or Right is equal to 1 or Right is equal to 3 or Right is equal to 5 or Right is equal to 7;
        Add 1 to FlowJoin_Result;
    Done.
    If Left is equal to 2 or Left is equal to 3 or Left is equal to 6 or Left is equal to 7 or Right is equal to 2 or Right is equal to 3 or Right is equal to 6 or Right is equal to 7;
        Add 2 to FlowJoin_Result;
    Done.
    If Left is equal to 4 or Left is equal to 5 or Left is equal to 6 or Left is equal to 7 or Right is equal to 4 or Right is equal to 5 or Right is equal to 6 or Right is equal to 7;
        Add 4 to FlowJoin_Result;
    Done.
    Return FlowJoin_Result;
Done.

# Branch recovery must never index beyond a truncated input.
Action FlowPeek;
    If FlowPos is less than 0 or FlowPos is greater than or equal to FlowLength;
        FlowBad = 1;
        Return "";
    Done.
    Get RawTokens FlowPos;
    Return @_;
Done.

# Stop mode 1 = ELSE or IF_END; 2 = IF_END; 3 = REPEAT_END.
# Recursive sequence evaluation considers both IF arms and joins their outputs.
Action FlowSequence0 FlowSeq0_Mode;
    FlowSeq0_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq0_Running is equal to 1;
        Call FlowPeek;
        FlowSeq0_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq0_Op is not equal to "BC_STORE_LIST" and FlowSeq0_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq0_IsStop = 0;
        If FlowSeq0_Mode is equal to 1 and FlowSeq0_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq0_IsStop = 1;
        Done.
        If FlowSeq0_Op is equal to "BC_IF_END" and FlowSeq0_Mode is not equal to 3;
            FlowSeq0_IsStop = 1;
        Done.
        If FlowSeq0_Mode is equal to 3 and FlowSeq0_Op is equal to "BC_REPEAT_END";
            FlowSeq0_IsStop = 1;
        Done.
        If FlowSeq0_IsStop is equal to 1;
            FlowSeq0_Running = 0;
        Else;
            If FlowSeq0_Op is equal to "BC_CONST";
                FlowSeq0_ArgPos = FlowPos + 1;
                If FlowSeq0_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq0_ArgPos;
                    FlowSeq0_Value = @_;
                    Call FlowLiteral FlowSeq0_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq0_Op is equal to "BC_STORE_LIST";
                    FlowSeq0_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq0_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq0_ArgPos;
                        FlowSeq0_Name = @_;
                        If FlowSeq0_Name is equal to "Fresh";
                            FlowFresh = FlowPending;
                        Else;
                            If FlowSeq0_Name is equal to "Other";
                                FlowOther = FlowPending;
                            Else;
                                If FlowSeq0_Name is equal to "Third";
                                    FlowThird = FlowPending;
                                Else;
                                    If FlowSeq0_Name is equal to "Fourth";
                                        FlowFourth = FlowPending;
                                    Else;
                                        FlowBad = 1;
                                    Done.
                                Done.
                            Done.
                        Done.
                        If FlowBad is equal to 0;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq0_Op is equal to "BC_LOADVAR";
                        FlowSeq0_ArgPos = FlowPos + 1;
                        FlowSeq0_PrintPos = FlowPos + 2;
                        If FlowSeq0_PrintPos is greater than or equal to FlowLength or FlowSeq0_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq0_ArgPos;
                            FlowSeq0_Name = @_;
                            FlowSeq0_NameOK = 0;
                            If FlowSeq0_Name is equal to "Fresh" or FlowSeq0_Name is equal to "Other" or FlowSeq0_Name is equal to "Third" or FlowSeq0_Name is equal to "Fourth";
                                FlowSeq0_NameOK = 1;
                            Done.
                            Get RawTokens FlowSeq0_PrintPos;
                            If FlowSeq0_NameOK is equal to 0 or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                FlowUseName = FlowSeq0_Name;
                                FlowUseMask = 0;
                                If FlowSeq0_Name is equal to "Fresh";
                                    FlowUseMask = FlowFresh;
                                Else;
                                    If FlowSeq0_Name is equal to "Other";
                                        FlowUseMask = FlowOther;
                                    Else;
                                        If FlowSeq0_Name is equal to "Third";
                                            FlowUseMask = FlowThird;
                                        Else;
                                            FlowUseMask = FlowFourth;
                                        Done.
                                    Done.
                                Done.
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "E".
                                        Print FlowUseMask.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "B".
                                        Print FlowUseMask.
                                    Done.
                                    If FlowUseMask is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq0_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                FlowSeq0_EntryFresh = FlowFresh;
                                FlowSeq0_EntryOther = FlowOther;
                                FlowSeq0_EntryThird = FlowThird;
                                FlowSeq0_EntryFourth = FlowFourth;
                                FlowPos = FlowPos + 1;
                                Call FlowSequence1 1;
                                FlowSeq0_ThenFresh = FlowFresh;
                                FlowSeq0_ThenOther = FlowOther;
                                FlowSeq0_ThenThird = FlowThird;
                                FlowSeq0_ThenFourth = FlowFourth;
                                Call FlowPeek;
                                FlowSeq0_Stop = @_;
                                If FlowSeq0_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    FlowFresh = FlowSeq0_EntryFresh;
                                    FlowOther = FlowSeq0_EntryOther;
                                    FlowThird = FlowSeq0_EntryThird;
                                    FlowFourth = FlowSeq0_EntryFourth;
                                    Call FlowSequence1 2;
                                    FlowSeq0_ElseFresh = FlowFresh;
                                    FlowSeq0_ElseOther = FlowOther;
                                    FlowSeq0_ElseThird = FlowThird;
                                    FlowSeq0_ElseFourth = FlowFourth;
                                Else;
                                    FlowSeq0_ElseFresh = FlowSeq0_EntryFresh;
                                    FlowSeq0_ElseOther = FlowSeq0_EntryOther;
                                    FlowSeq0_ElseThird = FlowSeq0_EntryThird;
                                    FlowSeq0_ElseFourth = FlowSeq0_EntryFourth;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowJoin FlowSeq0_ThenFresh, FlowSeq0_ElseFresh;
                                    FlowFresh = @_;
                                    Call FlowJoin FlowSeq0_ThenOther, FlowSeq0_ElseOther;
                                    FlowOther = @_;
                                    Call FlowJoin FlowSeq0_ThenThird, FlowSeq0_ElseThird;
                                    FlowThird = @_;
                                    Call FlowJoin FlowSeq0_ThenFourth, FlowSeq0_ElseFourth;
                                    FlowFourth = @_;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq0_Op is equal to "BC_ELSE_BEGIN" or FlowSeq0_Op is equal to "BC_IF_END" or FlowSeq0_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq0_Op is equal to "BC_REPEAT_END" or FlowSeq0_Op is equal to "BC_WHILE_BEGIN" or FlowSeq0_Op is equal to "BC_WHILE_TEST" or FlowSeq0_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.


Action FlowSequence1 FlowSeq1_Mode;
    FlowSeq1_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq1_Running is equal to 1;
        Call FlowPeek;
        FlowSeq1_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq1_Op is not equal to "BC_STORE_LIST" and FlowSeq1_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq1_IsStop = 0;
        If FlowSeq1_Mode is equal to 1 and FlowSeq1_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq1_IsStop = 1;
        Done.
        If FlowSeq1_Op is equal to "BC_IF_END" and FlowSeq1_Mode is not equal to 3;
            FlowSeq1_IsStop = 1;
        Done.
        If FlowSeq1_Mode is equal to 3 and FlowSeq1_Op is equal to "BC_REPEAT_END";
            FlowSeq1_IsStop = 1;
        Done.
        If FlowSeq1_IsStop is equal to 1;
            FlowSeq1_Running = 0;
        Else;
            If FlowSeq1_Op is equal to "BC_CONST";
                FlowSeq1_ArgPos = FlowPos + 1;
                If FlowSeq1_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq1_ArgPos;
                    FlowSeq1_Value = @_;
                    Call FlowLiteral FlowSeq1_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq1_Op is equal to "BC_STORE_LIST";
                    FlowSeq1_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq1_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq1_ArgPos;
                        FlowSeq1_Name = @_;
                        If FlowSeq1_Name is equal to "Fresh";
                            FlowFresh = FlowPending;
                        Else;
                            If FlowSeq1_Name is equal to "Other";
                                FlowOther = FlowPending;
                            Else;
                                If FlowSeq1_Name is equal to "Third";
                                    FlowThird = FlowPending;
                                Else;
                                    If FlowSeq1_Name is equal to "Fourth";
                                        FlowFourth = FlowPending;
                                    Else;
                                        FlowBad = 1;
                                    Done.
                                Done.
                            Done.
                        Done.
                        If FlowBad is equal to 0;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq1_Op is equal to "BC_LOADVAR";
                        FlowSeq1_ArgPos = FlowPos + 1;
                        FlowSeq1_PrintPos = FlowPos + 2;
                        If FlowSeq1_PrintPos is greater than or equal to FlowLength or FlowSeq1_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq1_ArgPos;
                            FlowSeq1_Name = @_;
                            FlowSeq1_NameOK = 0;
                            If FlowSeq1_Name is equal to "Fresh" or FlowSeq1_Name is equal to "Other" or FlowSeq1_Name is equal to "Third" or FlowSeq1_Name is equal to "Fourth";
                                FlowSeq1_NameOK = 1;
                            Done.
                            Get RawTokens FlowSeq1_PrintPos;
                            If FlowSeq1_NameOK is equal to 0 or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                FlowUseName = FlowSeq1_Name;
                                FlowUseMask = 0;
                                If FlowSeq1_Name is equal to "Fresh";
                                    FlowUseMask = FlowFresh;
                                Else;
                                    If FlowSeq1_Name is equal to "Other";
                                        FlowUseMask = FlowOther;
                                    Else;
                                        If FlowSeq1_Name is equal to "Third";
                                            FlowUseMask = FlowThird;
                                        Else;
                                            FlowUseMask = FlowFourth;
                                        Done.
                                    Done.
                                Done.
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "E".
                                        Print FlowUseMask.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "B".
                                        Print FlowUseMask.
                                    Done.
                                    If FlowUseMask is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq1_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                FlowSeq1_EntryFresh = FlowFresh;
                                FlowSeq1_EntryOther = FlowOther;
                                FlowSeq1_EntryThird = FlowThird;
                                FlowSeq1_EntryFourth = FlowFourth;
                                FlowPos = FlowPos + 1;
                                Call FlowSequence2 1;
                                FlowSeq1_ThenFresh = FlowFresh;
                                FlowSeq1_ThenOther = FlowOther;
                                FlowSeq1_ThenThird = FlowThird;
                                FlowSeq1_ThenFourth = FlowFourth;
                                Call FlowPeek;
                                FlowSeq1_Stop = @_;
                                If FlowSeq1_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    FlowFresh = FlowSeq1_EntryFresh;
                                    FlowOther = FlowSeq1_EntryOther;
                                    FlowThird = FlowSeq1_EntryThird;
                                    FlowFourth = FlowSeq1_EntryFourth;
                                    Call FlowSequence2 2;
                                    FlowSeq1_ElseFresh = FlowFresh;
                                    FlowSeq1_ElseOther = FlowOther;
                                    FlowSeq1_ElseThird = FlowThird;
                                    FlowSeq1_ElseFourth = FlowFourth;
                                Else;
                                    FlowSeq1_ElseFresh = FlowSeq1_EntryFresh;
                                    FlowSeq1_ElseOther = FlowSeq1_EntryOther;
                                    FlowSeq1_ElseThird = FlowSeq1_EntryThird;
                                    FlowSeq1_ElseFourth = FlowSeq1_EntryFourth;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowJoin FlowSeq1_ThenFresh, FlowSeq1_ElseFresh;
                                    FlowFresh = @_;
                                    Call FlowJoin FlowSeq1_ThenOther, FlowSeq1_ElseOther;
                                    FlowOther = @_;
                                    Call FlowJoin FlowSeq1_ThenThird, FlowSeq1_ElseThird;
                                    FlowThird = @_;
                                    Call FlowJoin FlowSeq1_ThenFourth, FlowSeq1_ElseFourth;
                                    FlowFourth = @_;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq1_Op is equal to "BC_ELSE_BEGIN" or FlowSeq1_Op is equal to "BC_IF_END" or FlowSeq1_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq1_Op is equal to "BC_REPEAT_END" or FlowSeq1_Op is equal to "BC_WHILE_BEGIN" or FlowSeq1_Op is equal to "BC_WHILE_TEST" or FlowSeq1_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.


Action FlowSequence2 FlowSeq2_Mode;
    FlowSeq2_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq2_Running is equal to 1;
        Call FlowPeek;
        FlowSeq2_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq2_Op is not equal to "BC_STORE_LIST" and FlowSeq2_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq2_IsStop = 0;
        If FlowSeq2_Mode is equal to 1 and FlowSeq2_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq2_IsStop = 1;
        Done.
        If FlowSeq2_Op is equal to "BC_IF_END" and FlowSeq2_Mode is not equal to 3;
            FlowSeq2_IsStop = 1;
        Done.
        If FlowSeq2_Mode is equal to 3 and FlowSeq2_Op is equal to "BC_REPEAT_END";
            FlowSeq2_IsStop = 1;
        Done.
        If FlowSeq2_IsStop is equal to 1;
            FlowSeq2_Running = 0;
        Else;
            If FlowSeq2_Op is equal to "BC_CONST";
                FlowSeq2_ArgPos = FlowPos + 1;
                If FlowSeq2_ArgPos is greater than or equal to FlowLength;
                    FlowBad = 1;
                Else;
                    Get RawTokens FlowSeq2_ArgPos;
                    FlowSeq2_Value = @_;
                    Call FlowLiteral FlowSeq2_Value;
                    FlowPending = @_;
                    FlowPos = FlowPos + 2;
                Done.
            Else;
                If FlowSeq2_Op is equal to "BC_STORE_LIST";
                    FlowSeq2_ArgPos = FlowPos + 1;
                    If FlowPending is equal to 0 or FlowSeq2_ArgPos is greater than or equal to FlowLength;
                        FlowBad = 1;
                    Else;
                        Get RawTokens FlowSeq2_ArgPos;
                        FlowSeq2_Name = @_;
                        If FlowSeq2_Name is equal to "Fresh";
                            FlowFresh = FlowPending;
                        Else;
                            If FlowSeq2_Name is equal to "Other";
                                FlowOther = FlowPending;
                            Else;
                                If FlowSeq2_Name is equal to "Third";
                                    FlowThird = FlowPending;
                                Else;
                                    If FlowSeq2_Name is equal to "Fourth";
                                        FlowFourth = FlowPending;
                                    Else;
                                        FlowBad = 1;
                                    Done.
                                Done.
                            Done.
                        Done.
                        If FlowBad is equal to 0;
                            FlowPending = 0;
                            FlowPos = FlowPos + 2;
                        Done.
                    Done.
                Else;
                    If FlowSeq2_Op is equal to "BC_LOADVAR";
                        FlowSeq2_ArgPos = FlowPos + 1;
                        FlowSeq2_PrintPos = FlowPos + 2;
                        If FlowSeq2_PrintPos is greater than or equal to FlowLength or FlowSeq2_ArgPos is greater than or equal to FlowLength;
                            FlowBad = 1;
                        Else;
                            Get RawTokens FlowSeq2_ArgPos;
                            FlowSeq2_Name = @_;
                            FlowSeq2_NameOK = 0;
                            If FlowSeq2_Name is equal to "Fresh" or FlowSeq2_Name is equal to "Other" or FlowSeq2_Name is equal to "Third" or FlowSeq2_Name is equal to "Fourth";
                                FlowSeq2_NameOK = 1;
                            Done.
                            Get RawTokens FlowSeq2_PrintPos;
                            If FlowSeq2_NameOK is equal to 0 or @_ is not equal to "BC_PRINT";
                                FlowBad = 1;
                            Else;
                                FlowUseName = FlowSeq2_Name;
                                FlowUseMask = 0;
                                If FlowSeq2_Name is equal to "Fresh";
                                    FlowUseMask = FlowFresh;
                                Else;
                                    If FlowSeq2_Name is equal to "Other";
                                        FlowUseMask = FlowOther;
                                    Else;
                                        If FlowSeq2_Name is equal to "Third";
                                            FlowUseMask = FlowThird;
                                        Else;
                                            FlowUseMask = FlowFourth;
                                        Done.
                                    Done.
                                Done.
                                If FlowEmit is equal to 1;
                                    If FlowTrip is equal to 0;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "E".
                                        Print FlowUseMask.
                                    Else;
                                        Print "USE".
                                        Print FlowPos.
                                        Print FlowUseName.
                                        Print "B".
                                        Print FlowUseMask.
                                    Done.
                                    If FlowUseMask is not equal to 4;
                                        FlowDecision = 0;
                                    Done.
                                Done.
                                FlowPos = FlowPos + 3;
                            Done.
                        Done.
                    Else;
                        If FlowSeq2_Op is equal to "BC_IF_BEGIN";
                            Add 1 to FlowDepth;
                            If FlowDepth is greater than 16 or FlowPending is equal to 0;
                                FlowBad = 1;
                                Add -1 to FlowDepth;
                            Else;
                                FlowPending = 0;
                                FlowSeq2_EntryFresh = FlowFresh;
                                FlowSeq2_EntryOther = FlowOther;
                                FlowSeq2_EntryThird = FlowThird;
                                FlowSeq2_EntryFourth = FlowFourth;
                                FlowPos = FlowPos + 1;
                                Call FlowSequence3 1;
                                FlowSeq2_ThenFresh = FlowFresh;
                                FlowSeq2_ThenOther = FlowOther;
                                FlowSeq2_ThenThird = FlowThird;
                                FlowSeq2_ThenFourth = FlowFourth;
                                Call FlowPeek;
                                FlowSeq2_Stop = @_;
                                If FlowSeq2_Stop is equal to "BC_ELSE_BEGIN";
                                    FlowPos = FlowPos + 1;
                                    FlowFresh = FlowSeq2_EntryFresh;
                                    FlowOther = FlowSeq2_EntryOther;
                                    FlowThird = FlowSeq2_EntryThird;
                                    FlowFourth = FlowSeq2_EntryFourth;
                                    Call FlowSequence3 2;
                                    FlowSeq2_ElseFresh = FlowFresh;
                                    FlowSeq2_ElseOther = FlowOther;
                                    FlowSeq2_ElseThird = FlowThird;
                                    FlowSeq2_ElseFourth = FlowFourth;
                                Else;
                                    FlowSeq2_ElseFresh = FlowSeq2_EntryFresh;
                                    FlowSeq2_ElseOther = FlowSeq2_EntryOther;
                                    FlowSeq2_ElseThird = FlowSeq2_EntryThird;
                                    FlowSeq2_ElseFourth = FlowSeq2_EntryFourth;
                                Done.
                                Call FlowPeek;
                                If @_ is not equal to "BC_IF_END";
                                    FlowBad = 1;
                                Else;
                                    Call FlowJoin FlowSeq2_ThenFresh, FlowSeq2_ElseFresh;
                                    FlowFresh = @_;
                                    Call FlowJoin FlowSeq2_ThenOther, FlowSeq2_ElseOther;
                                    FlowOther = @_;
                                    Call FlowJoin FlowSeq2_ThenThird, FlowSeq2_ElseThird;
                                    FlowThird = @_;
                                    Call FlowJoin FlowSeq2_ThenFourth, FlowSeq2_ElseFourth;
                                    FlowFourth = @_;
                                    FlowPos = FlowPos + 1;
                                Done.
                                Add -1 to FlowDepth;
                            Done.
                        Else;
                            If FlowSeq2_Op is equal to "BC_ELSE_BEGIN" or FlowSeq2_Op is equal to "BC_IF_END" or FlowSeq2_Op is equal to "BC_REPEAT_BEGIN" or FlowSeq2_Op is equal to "BC_REPEAT_END" or FlowSeq2_Op is equal to "BC_WHILE_BEGIN" or FlowSeq2_Op is equal to "BC_WHILE_TEST" or FlowSeq2_Op is equal to "BC_WHILE_END";
                                FlowBad = 1;
                            Else;
                                FlowBad = 1;
                            Done.
                        Done.
                    Done.
                Done.
            Done.
        Done.
    Done.
    If FlowPending is not equal to 0;
        FlowBad = 1;
    Done.
Done.


Action FlowSequence3 FlowSeq3_Mode;
    FlowSeq3_Running = 1;
    While FlowPos is less than FlowLength and FlowBad is equal to 0 and FlowSeq3_Running is equal to 1;
        Call FlowPeek;
        FlowSeq3_Op = @_;
        # A literal must be consumed immediately by its store or condition.
        If FlowPending is not equal to 0 and FlowSeq3_Op is not equal to "BC_STORE_LIST" and FlowSeq3_Op is not equal to "BC_IF_BEGIN";
            FlowBad = 1;
        Done.
        FlowSeq3_IsStop = 0;
        If FlowSeq3_Mode is equal to 1 and FlowSeq3_Op is equal to "BC_ELSE_BEGIN";
            FlowSeq3_IsStop = 1;
        Done.
        If FlowSeq3_Op is equal to "BC_IF_END" and FlowSeq3_Mode is not equal to 3;
            FlowSeq3_IsStop = 1;
        Done.
        If FlowSeq3_Mode is equal to 3 and FlowSeq3_Op is equal to "BC_REPEAT_END";
